<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WishfulClaw.Contracts\WishfulClaw.Contracts.csproj" />
    <ProjectReference Include="..\WishfulClaw.Core\WishfulClaw.Core.csproj" />
    <ProjectReference Include="..\WishfulClaw.Agent\WishfulClaw.Agent.csproj" />
    <ProjectReference Include="..\WishfulClaw.Persona\WishfulClaw.Persona.csproj" />
    <ProjectReference Include="..\WishfulClaw.Workspace\WishfulClaw.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SqlSugarCore" Version="5.1.4.216" />
    <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 has GHSA-2m69-gcr7-jv3q (SQLite engine vuln).
         This is a transitive dep via SqlSugarCore -> Microsoft.Data.Sqlite 10.0.9.
         Cannot upgrade independently without breaking SqlSugar compatibility.
         Suppress until SqlSugarCore bumps its Microsoft.Data.Sqlite dependency. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.11" NoWarn="NU1903" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded persona preset markdown files -->
    <EmbeddedResource Include="Resources\Personas\**\*.md" />
  </ItemGroup>

</Project>
